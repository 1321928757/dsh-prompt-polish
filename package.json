{
  "name": "dsh-prompt-polish",
  "version": "0.4.1",
  "description": "DeepSeek Harness 输入栏提示词优化插件：6 种策略 × 3 种语言与自定义指令重写草稿，可选携带聊天上下文（含压缩摘要）、目标与任务清单，结果确认弹窗、最近 5 次历史与三级设置持久化。Input-bar prompt optimizer for DeepSeek Harness: rewrites drafts with 6 strategies × 3 languages plus custom instructions, optional chat context (with compaction summary), goal and todo injection, a confirm dialog, last-5 history and three-tier settings persistence.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./typert": {
      "default": "./lib/typert.host.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/shared.js",
    "lib/typert.host.js",
    "lib/client.js",
    "test/typert.test.mjs",
    "test/client-typert.test.mjs",
    "test/package-contract.test.mjs",
    "test/shared.test.mjs",
    "cordis.patch.yml",
    "scripts/install.ps1",
    "scripts/dsh02-headless-smoke.ps1",
    "scripts/dsh02-web-smoke.ps1",
    "scripts/web-boot-probe.mjs",
    "CHANGELOG.md",
    "README.md",
    "README.zh-CN.md",
    "screenshots.json",
    "assets",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "prompt",
    "prompt-engineering",
    "optimizer",
    "polish",
    "ui",
    "composer",
    "zh",
    "en"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1321928757/dsh-prompt-polish.git"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0",
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/cordis-plugin-timer": "1.1.6",
    "@deepseek-ai/dsh-agent-default-model": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-fs": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-typert-loader": ">=0.2.0-rc.2 <0.3.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/cordis-plugin-timer": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-default-model": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
